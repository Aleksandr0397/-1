# Создайте собственный длинный пароль для загрузки общего прайса.
ADMIN_TOKEN=
DATA_DIR=./data
# Необязательный начальный каталог. Используется только при пустой базе.
INITIAL_CATALOG_FILE=

# Постоянный PostgreSQL для аккаунтов, истории и каталога.
# Приложение использует только свою схему okunev_orders.
ORDERS_DATABASE_URL=
# Только для локальной разработки: отдельный явный каталог SQLite-истории.
# На бесплатном хостинге с временным диском это поле оставьте пустым.
ORDERS_HISTORY_DIR=
# На публичном HTTPS-сайте задайте 1; пустое значение определяется по схеме запроса.
SESSION_COOKIE_SECURE=

# Адрес, на который поступают заказы.
ORDERS_TO=aleksandr0397@bk.ru

# Данные почтового сервера отправителя. Секреты храните только в .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
